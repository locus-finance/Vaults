    "prettier:js": "./node_modules/.bin/prettier --write test/*.js test/**/*.js scripts/*.js",
    "lint": "npm run prettier:solidity && npm run prettier:js && npm run eslint:all-fix && npm run solhint:all",
    "update-addresses": "npx hardhat update"
  },
  "engines": {
    "node": ">=8.3.0"
  },
